# Copy to .env and fill in only the services you use. Never commit .env.
# Every value is optional: local import, review and MP4 export run without any key.
# Keys can also be saved from the Settings screen, which writes to the same file.

PORT=7820

# Dify director workflow (planning, continuity review, human approval).
# Import workflows/production/director-production.yml into Dify, publish it, paste its app key.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_PRODUCTION_KEY=
# Optional single-shot revision app (workflows/production/shot-revision.yml).
DIFY_REVISION_KEY=

# fal image and video generation for prepared shot segments.
FAL_KEY=

# OpenAI direct connection for dialogue speech and single-shot proposals.
# Speech needs: python3 -m pip install -r requirements-realtime.txt
OPENAI_API_KEY=

# Legacy per-stage Dify apps. Leave empty unless you already run them.
# DIFY_SCRIPT_KEY=
# DIFY_ASSETS_KEY=
# DIFY_SHOTS_KEY=
# DIFY_PLAN_KEY=
# DIFY_QC_KEY=
# DIFY_IMAGE_KEY=
# DIFY_VIDEO_KEY=
# DIFY_AUDIO_KEY=
# DIFY_AUDIO_PROFILE=

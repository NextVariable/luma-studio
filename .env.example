DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_SCRIPT_KEY=
DIFY_ASSETS_KEY=
DIFY_SHOTS_KEY=
# 现有31节点制作工作流发布后的应用Key，优先用于分镜，支持流式和人工审批
DIFY_PRODUCTION_KEY=
# 单镜修订 DSL 需独立发布；媒体应用须遵循 docs/production-refactor.md 的输入输出契约
DIFY_REVISION_KEY=
DIFY_IMAGE_KEY=
DIFY_VIDEO_KEY=
# 可选，给明确选用 fal 模型的制作片段提供图像和视频生成。
FAL_KEY=
# 仅供已提交的旧版 Dify 配音任务恢复。
DIFY_AUDIO_KEY=
# 发布本仓库新版角色逐句配音 DSL 后启用，旧版固定音色应用留空
DIFY_AUDIO_PROFILE=
DIFY_PLAN_KEY=
DIFY_QC_KEY=
PORT=7820
# 新配音使用 OpenAI 直连，需要安装 requirements-realtime.txt。导演分镜仍走 Dify。
OPENAI_API_KEY=
